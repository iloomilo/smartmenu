# Host-Port für den Postgres-Container.
# Ändern, falls auf 5432 schon eine lokale Postgres-Instanz läuft.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=smartmenu

DATABASE_URL=postgres://smartmenu:smartmenu@localhost:5432/smartmenu

# Modell: OpenAI-kompatible Chat-Completions-API.
# Lokal empfohlen: Qwen3-VL-8B über vLLM oder Ollama.
#   Ollama: ollama serve && ollama pull qwen3-vl:8b
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_NAME=qwen3-vl:8b

# Ortssuche über OpenStreetMap. Kontaktadresse ist Overpass-Fair-Use-Pflicht.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_CONTACT_EMAIL=
